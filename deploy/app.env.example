# /root/.local/share/pit-social/app.env  (chmod 600). Every variable pit-social reads.

# --- required ---------------------------------------------------------------
# The shared bridge key. pit.world derives each client secret from it:
#   secret(social.<name>.pit.world) = base64url(HMAC-SHA256(PIT_BRIDGE_KEY, "social.<name>.pit.world"))
# Must be the same value pit.world uses. Without it, sign-in is off.
PIT_BRIDGE_KEY=

# Bridge subs (CoinPay DIDs) who are admins of every community, comma separated.
PIT_SOCIAL_ADMINS=

# --- where it runs (the systemd unit sets these) -------------------------------
# PORT=8794
# HOST=127.0.0.1
# PIT_SOCIAL_DATA_DIR=/root/.local/share/pit-social     (pit-social.db lives here)

# --- the network side -----------------------------------------------------------
# Comma-separated wss:// URLs. A /subscribe path is a jetstream (JSON); anything else is a
# full relay (com.atproto.sync.subscribeRepos is added when there is no path). Default:
# PIT_SOCIAL_RELAYS=wss://jetstream2.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post,wss://jetstream1.us-west.bsky.network/subscribe?wantedCollections=app.bsky.feed.post,wss://atproto.africa,wss://relay.fire.hose.cam,wss://relay.upcloud.world,wss://relay.waow.tech,wss://bsky.network
# PIT_SOCIAL_INGEST=on            off: do not connect (a second web process, tests)
# PIT_SOCIAL_RETENTION_DAYS=30    network posts older than this are pruned (hourly)
# PIT_SOCIAL_CAP=20000            at most this many network posts per community
# PIT_SOCIAL_MAX_LAG_S=120        a relay this late for 30 s has its backlog shed
# PIT_SOCIAL_HANDLES=on           off: never look up did -> handle at plc.directory
# PIT_SOCIAL_PLC_URL=https://plc.directory

# --- sign-in + pit.world ----------------------------------------------------------
# PIT_WORLD_URL=https://pit.world                 listings (/api/listing?domain=) and the bridge base
# PIT_BRIDGE_AUTHORIZE_URL=https://pit.world/bridge/authorize
# PIT_BRIDGE_TOKEN_URL=https://pit.world/bridge/token
# PIT_SOCIAL_BRIDGE_AUTO=on       off: never try silent (prompt=none) sign-in
# PIT_SOCIAL_POSTS_PER_HOUR=30    per member, across every community
