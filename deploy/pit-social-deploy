#!/bin/bash
# Forced command for the pit-social CI deploy key (root authorized_keys, restrict).
# Accepts one argument: a 40-hex commit that is already on origin/main. Checks it
# out in /opt/pit-social and runs bin/install.sh. Nothing else is possible with that key.
set -euo pipefail
sha="${SSH_ORIGINAL_COMMAND:-}"
sha="${sha##* }"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "pit-social-deploy: expected a 40-hex sha" >&2; exit 2; }
cd /opt/pit-social
git fetch -q origin main
git merge-base --is-ancestor "$sha" origin/main || { echo "pit-social-deploy: $sha is not on origin/main" >&2; exit 3; }
git checkout -q main && git merge -q --ff-only "$sha"
echo "pit-social-deploy: at $(git log --oneline -1)"
exec ./bin/install.sh
